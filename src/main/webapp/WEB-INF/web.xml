<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>Gestor de Activos Empresariales</display-name>

    <!-- Filtros: el orden de los filter-mapping define el orden de ejecución -->
    <filter>
        <filter-name>CabecerasSeguridad</filter-name>
        <filter-class>pe.edu.utp.gestoractivos.filter.CabecerasSeguridadFilter</filter-class>
    </filter>
    <filter>
        <filter-name>Csrf</filter-name>
        <filter-class>pe.edu.utp.gestoractivos.filter.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>Auth</filter-name>
        <filter-class>pe.edu.utp.gestoractivos.filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>Admin</filter-name>
        <filter-class>pe.edu.utp.gestoractivos.filter.AdminFilter</filter-class>
    </filter>

    <filter-mapping><filter-name>CabecerasSeguridad</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Csrf</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Auth</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Admin</filter-name><url-pattern>/activos/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Admin</filter-name><url-pattern>/asignaciones/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Admin</filter-name><url-pattern>/empleados/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>Admin</filter-name><url-pattern>/usuarios/*</url-pattern></filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page><error-code>403</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
    <error-page><error-code>404</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
</web-app>
